{
  "name": "ascend-focus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:curriculum && npm run test:community && npm run test:backend",
    "test:community": "node --experimental-strip-types src/community.checks.mjs",
    "server": "node server/app.mjs",
    "test:backend": "node server/community.test.mjs",
    "test:backend:http": "ASCEND_HTTP_TESTS=1 node server/community.test.mjs",
    "test:curriculum": "node --experimental-strip-types src/curriculum.checks.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
